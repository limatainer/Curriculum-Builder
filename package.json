{
  "name": "cv builder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "start": "vite",
    "format": "biome check --write . && tsc --noEmit && (codegraph sync || true)",
    "lint": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prepare": "husky",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@tanstack/react-router": "1.170.29",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.3",
    "motion": "^13.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@tailwindcss/vite": "4.1.12",
    "@tanstack/router-plugin": "1.168.32",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "husky": "9.1.7",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.3.5"
  }
}
