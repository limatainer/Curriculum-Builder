{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json}",
      "!src/routeTree.gen.ts",
      "*.json",
      "vite.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "formatWithErrors": true
  },
  "linter": {
    "enabled": true,
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json}",
      "!src/routeTree.gen.ts",
      "*.json",
      "vite.config.ts"
    ],
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noUnknownAtRules": "off", "noArrayIndexKey": "off" },
      "correctness": { "useUniqueElementIds": "off", "noUnusedImports": "error" },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useButtonType": "off"
      }
    }
  },
  "javascript": {
    "formatter": { "semicolons": "always", "trailingCommas": "es5" }
  },
  "css": { "formatter": { "enabled": false } }
}
